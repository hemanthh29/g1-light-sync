Version: 1.0.10-8
Section: utils
Priority: optional
Architecture: all
Depends: gir1.2-ayatanaappindicator3-0.1, adduser, gir1.2-gst-plugins-base-1.0, gir1.2-gstreamer-1.0, gstreamer1.0-pipewire, pipewire-bin, python3 (>= 3.10), fonts-noto-core, python3-dbus, python3-gi, python3-gst-1.0, python3-hid, python3-numpy, python3-pil, python3-tk, udev, xdg-desktop-portal
